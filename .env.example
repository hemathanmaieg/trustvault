# Copy to .env for local development. Never commit the real .env.
NODE_ENV=development
PORT=3000

# PostgreSQL connection string
DATABASE_URL=postgres://trustvault:trustvault_local@localhost:5432/trustvault_dev
# Set to true on hosts that require SSL to the database (Render: usually not needed on the internal URL)
DATABASE_SSL=false

# Secret key for the audit log hash chain. Use a long random value in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUDIT_HMAC_KEY=dev-only-audit-key-change-me

# Session lifetimes
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8

# Seed account passwords (required in production, defaults used in development)
SEED_ADMIN_PASSWORD=AdminDemo2026!
SEED_OWNER_PASSWORD=OwnerDemo2026!
SEED_VIEWER_PASSWORD=ViewerDemo2026!
