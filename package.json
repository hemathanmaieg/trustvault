{
  "name": "trustvault",
  "version": "1.0.0",
  "private": true,
  "description": "TrustVault - secure document sharing with a tamper-evident audit trail",
  "main": "server/src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/src/server.js",
    "dev": "node --watch server/src/server.js",
    "migrate": "node server/db/migrate.js",
    "seed": "node server/db/seed.js",
    "setup": "npm run migrate && npm run seed",
    "build": "npm --prefix client ci --include=dev && npm --prefix client run build",
    "test": "node --test --test-concurrency=1 \"server/test/**/*.test.js\"",
    "test:authz-removal": "node server/scripts/authz-removal-check.js",
    "verify-audit": "node server/scripts/verify-audit.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.8",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "file-type": "^22.2.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
